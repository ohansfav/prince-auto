{
  "name": "Communication Agent",
  "nodes": [
    {
      "parameters": {
        "path": "communicate",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "collection": "patients",
        "query": "={\"patientId\": \"={{$json.patientId}}\"}"
      },
      "name": "Get Patient Details",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.communicationChannel}}",
              "value2": "email"
            }
          ]
        }
      },
      "name": "Check Channel",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "noreply@healthclinic.com",
        "toEmail": "={{$node[\"Get Patient Details\"].json[0].email}}",
        "subject": "={{$json.subject}}",
        "textOnly": false,
        "htmlBody": "={{$json.message}}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "credentials": "twilio",
        "toNumber": "={{$node[\"Get Patient Details\"].json[0].phone}}",
        "message": "={{$json.message}}"
      },
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "communications",
        "data": "={\n  \"communicationId\": \"=uuid()\",\n  \"patientId\": \"={{$json.patientId}}\",\n  \"channel\": \"={{$json.communicationChannel}}\",\n  \"message\": \"={{$json.message}}\",\n  \"sentAt\": \"={{Date.now()}}\",\n  \"status\": \"sent\"\n}"
      },
      "name": "Log Communication",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "responseData": "={{$node[\"Log Communication\"].json}}"
      },
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Get Patient Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Patient Details": {
      "main": [
        [
          {
            "node": "Check Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Channel": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Log Communication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send SMS": {
      "main": [
        [
          {
            "node": "Log Communication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Communication": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
