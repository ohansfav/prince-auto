{
  "name": "Reminder Agent",
  "nodes": [
    {
      "parameters": {
        "path": "reminder",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "collection": "appointments",
        "query": "={\"appointmentId\": \"={{$json.appointmentId}}\"}"
      },
      "name": "Get Appointment",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "collection": "patients",
        "query": "={\"patientId\": \"={{$node[\"Get Appointment\"].json[0].patientId}}\"}"
      },
      "name": "Get Patient",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "noreply@healthclinic.com",
        "toEmail": "={{$node[\"Get Patient\"].json[0].email}}",
        "subject": "Appointment Reminder",
        "textOnly": false,
        "htmlBody": "=<h2>Appointment Reminder</h2>\n<p>Dear {{$node[\"Get Patient\"].json[0].firstName}},</p>\n<p>This is a reminder about your upcoming appointment:</p>\n<ul>\n<li><strong>Doctor:</strong> {{$node[\"Get Appointment\"].json[0].doctorName}}</li>\n<li><strong>Date:</strong> {{$node[\"Get Appointment\"].json[0].appointmentDate}}</li>\n<li><strong>Time:</strong> {{$node[\"Get Appointment\"].json[0].appointmentTime}}</li>\n</ul>\n<p>Please reply to confirm or cancel.</p>"
      },
      "name": "Send Email Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "reminders",
        "data": "={\n  \"reminderId\": \"=uuid()\",\n  \"appointmentId\": \"={{$json.appointmentId}}\",\n  \"patientId\": \"={{$node[\"Get Patient\"].json[0].patientId}}\",\n  \"message\": \"Appointment reminder sent\",\n  \"sentAt\": \"={{Date.now()}}\",\n  \"deliveryStatus\": \"sent\",\n  \"followUpStatus\": \"pending\",\n  \"channel\": \"email\"\n}"
      },
      "name": "Log Reminder",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "responseData": "={{$node[\"Log Reminder\"].json}}"
      },
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Get Appointment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Appointment": {
      "main": [
        [
          {
            "node": "Get Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Patient": {
      "main": [
        [
          {
            "node": "Send Email Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email Reminder": {
      "main": [
        [
          {
            "node": "Log Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Reminder": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
